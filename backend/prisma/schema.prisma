generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String
  passwordHash  String
  role          UserRole       @default(USER)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  auditLogs     AuditLog[]
  bookings      Booking[]
  refreshTokens RefreshToken[]
  reviews       Review[]
  tripsLed      Trip[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id              Int      @id @default(autoincrement())
  token           String   @unique
  userId          Int
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         UserRole
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model Trek {
  id                 String        @id
  slug               String?       @unique
  title              String
  subtitle           String?
  location           String
  state              String?
  price              Decimal       @db.Decimal(10, 2)
  discountPrice      Decimal?      @db.Decimal(10, 2)
  days               String
  description        String
  highlights         Json          @default("[]")
  thingsToCarry      Json          @default("[]")
  faqs               Json          @default("[]")
  policies           Json          @default("[]")
  cancellationRules  Json          @default("[]")
  googleMapLink      String?
  heroImage          String?
  videos             Json          @default("[]")
  zone               String
  difficulty         String
  duration           String
  elevation          String
  groupSize          String
  bestSeason         String
  meetingPoint       String
  inclusions         Json          @default("[]")
  exclusions         Json          @default("[]")
  timeline           Json          @default("[]")
  metaTitle          String?
  metaDescription    String?
  keywords           String?
  ogImage            String?
  canonicalUrl       String?
  structuredData     Json?
  status             String        @default("PUBLISHED")
  publishScheduledAt DateTime?
  version            Int           @default(1)
  featured           Boolean       @default(false)
  seasonal           Boolean       @default(false)
  maxSeats           Int           @default(30)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  images             Image[]
  reviews            Review[]
  versions           TrekVersion[]
  trips              Trip[]

  @@index([zone, price])
  @@index([difficulty])
  @@index([status])
  @@index([featured])
}

model TrekVersion {
  id        Int      @id @default(autoincrement())
  trekId    String
  version   Int
  data      Json
  editedBy  String?
  createdAt DateTime @default(now())
  trek      Trek     @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@index([trekId, version])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  trekId    String
  createdAt DateTime @default(now())
  trek      Trek     @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@index([trekId])
}

model Trip {
  id                 String      @id
  trekId             String
  date               DateTime
  totalSeats         Int
  bookedSeats        Int         @default(0)
  status             TripStatus  @default(UPCOMING)
  tripLeaderId       Int?
  currentLat         Float       @default(0.0)
  currentLng         Float       @default(0.0)
  lastLocationUpdate DateTime?
  trackingToken      String      @unique
  speed              Float       @default(0.0)
  batteryLevel       Int         @default(100)
  eta                String?
  bookings           Booking[]
  sosAlerts          SosAlert[]
  trek               Trek        @relation(fields: [trekId], references: [id])
  tripLeader         User?       @relation(fields: [tripLeaderId], references: [id])
  photos             TripPhoto[]

  @@index([trekId, status])
  @@index([date])
  @@index([trackingToken])
}

model SosAlert {
  id        Int       @id @default(autoincrement())
  tripId    String
  lat       Float
  lng       Float
  status    SosStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  trip      Trip      @relation(fields: [tripId], references: [id])

  @@index([tripId, status])
}

model TripPhoto {
  id        Int      @id @default(autoincrement())
  tripId    String
  url       String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  tripId      String
  members     Int
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  trip        Trip          @relation(fields: [tripId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  payments    Payment[]

  @@index([userId, status])
  @@index([tripId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int
  amount        Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?       @unique
  method        String        @default("UPI")
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId, paymentStatus])
  @@index([transactionId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  trekId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  trek      Trek     @relation(fields: [trekId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([trekId, rating])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum TripStatus {
  UPCOMING
  STARTING
  ON_ROUTE
  REACHED_DESTINATION
  RETURNING
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  ON_TRIP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum SosStatus {
  ACTIVE
  RESOLVED
}

enum UserRole {
  USER
  LEADER
  ADMIN
}
